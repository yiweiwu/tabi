rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Firestore paths are scoped by the signed-in Firebase Auth uid
// (Sign in with Apple or Google, wired up in AuthenticationPageView.swift
// via AuthenticationManager). Ownership of the {userId} path segment is
// enforced below via request.auth.uid == userId - a caller cannot read or
// write another user's documents even if they know the uid.
//
// Document: users/{userId}
// The user's profile - fields live directly on this document (not a
// subcollection) since a profile is 1:1 with the user. Populated by
// OnboardingCoordinator.completeOnboarding() and edited via ProfileView,
// both through UserProfileStore.
// Fields (all optional - a doc may exist with only some of these set):
//   - firstName, lastName, gender, age, height, weight: string
//   - allergies: list of allergy maps (id, name, type, severity, symptoms, notes)
//   - pharmacies: list of pharmacy maps (id, name, address, pharmacistName, phoneNumber, notes)
//   - settings: map (unitSystem, locationPermissionEnabled, countryOfResidence,
//     emailAddress, faceIDEnabled) - not deeply validated below, same as the
//     list contents in doses/sharedPeople.
//
// Collection: users/{userId}/doses/{medicationId}
// Document ID: medicationId (UUID string)
// Fields:
//   - entries: list (required) - list of dose entry maps, each with:
//       - id: string (UUID)
//       - medicationId: string (UUID)
//       - medicationName: string
//       - dosage: string
//       - scheduledDate: number (seconds since 2001-01-01 reference date)
//       - status: map { type: string ("upcoming"|"taken"|"skipped"|"missed"), date: number (optional) }
//     NOTE: Firestore rules cannot iterate list contents, so individual
//     entry fields inside the list are NOT deeply validated here - only
//     the list itself (presence, type, size cap).
//
// Collection: users/{userId}/sharedPeople/{personId}
// Document ID: personId (UUID string, matches SharedPerson.id)
// Fields:
//   - id: string (required, UUID)
//   - name: string (required)
//   - phoneNumber: string (optional)
//   - email: string (optional)
//   - dateAdded: number (required, seconds since 2001-01-01 reference date)
//   - optInStatus: string (optional, "pending"|"confirmed") - the client may
//     only ever write "pending" (or omit it); "confirmed" is set exclusively
//     by the confirmCaretakerOptIn Cloud Function via the Admin SDK, which
//     bypasses these rules. See isValidOptInStatus().
//
// Collection: missed_pill_alerts/{alertId} (top-level, not user-scoped)
// Written by any signed-in client when a dose goes missed; only the
// sendMissedPillAlert Cloud Function (Admin SDK, bypasses these rules)
// reads/deletes it, so clients may only create.
// Fields:
//   - caretakerPhone: string (required)
//   - medicationName: string (required)
//   - scheduledDate: number (required, seconds since 2001-01-01 reference date)
//
// Collection: connection_confirmations/{confirmationId} (top-level, not user-scoped)
// Written by any signed-in client when a caretaker connection is added;
// only the sendConnectionConfirmation Cloud Function (Admin SDK) reads it.
// The function composes the outbound SMS (including a confirmCaretakerOptIn
// link) from these structured fields server-side.
// Fields:
//   - uid: string (required, must equal request.auth.uid)
//   - sharedPersonId: string (required, matches the SharedPerson.id this confirmation is for)
//   - phone: string (required)
//   - contactName: string (required)
//   - patientName: string (required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidOptionalString(field, maxLen) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() <= maxLen);
    }

    function isValidDosesDoc() {
      return hasOnlyAllowedFields(['entries']) &&
             hasRequiredFields(['entries']) &&
             request.resource.data.entries is list &&
             request.resource.data.entries.size() <= 5000;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // The client may create/update with optInStatus absent, null, or
    // 'pending'. 'confirmed' may only appear if it was already the stored
    // value (i.e. set by confirmCaretakerOptIn's Admin SDK write, which
    // bypasses these rules) - a client can never newly set it to 'confirmed'.
    // On create, resource == null, so a doc can never be created already
    // "confirmed".
    function isValidOptInStatus() {
      return !('optInStatus' in request.resource.data) ||
             request.resource.data.optInStatus == null ||
             request.resource.data.optInStatus == 'pending' ||
             (resource != null && request.resource.data.optInStatus == resource.data.optInStatus);
    }

    // Unlike the doses/sharedPeople list contents (which rules cannot
    // iterate, per the NOTE above), `settings` is a single map, so its
    // fields can and should be validated directly.
    function isValidUserSettings() {
      return request.resource.data.settings.keys().hasOnly(['unitSystem', 'locationPermissionEnabled', 'countryOfResidence', 'emailAddress', 'faceIDEnabled']) &&
             (!('unitSystem' in request.resource.data.settings) ||
              request.resource.data.settings.unitSystem in ['Imperial', 'Metric']) &&
             (!('locationPermissionEnabled' in request.resource.data.settings) ||
              request.resource.data.settings.locationPermissionEnabled is bool) &&
             (!('countryOfResidence' in request.resource.data.settings) ||
              (request.resource.data.settings.countryOfResidence is string &&
               request.resource.data.settings.countryOfResidence.size() <= 100)) &&
             (!('emailAddress' in request.resource.data.settings) ||
              (request.resource.data.settings.emailAddress is string &&
               request.resource.data.settings.emailAddress.size() <= 200)) &&
             (!('faceIDEnabled' in request.resource.data.settings) ||
              request.resource.data.settings.faceIDEnabled is bool);
    }

    function isValidUserProfile() {
      return hasOnlyAllowedFields(['firstName', 'lastName', 'gender', 'age', 'height', 'weight', 'allergies', 'pharmacies', 'settings']) &&
             isValidOptionalString('firstName', 100) &&
             isValidOptionalString('lastName', 100) &&
             isValidOptionalString('gender', 50) &&
             isValidOptionalString('age', 10) &&
             isValidOptionalString('height', 10) &&
             isValidOptionalString('weight', 10) &&
             (!('allergies' in request.resource.data) ||
              (request.resource.data.allergies is list && request.resource.data.allergies.size() <= 100)) &&
             (!('pharmacies' in request.resource.data) ||
              (request.resource.data.pharmacies is list && request.resource.data.pharmacies.size() <= 100)) &&
             (!('settings' in request.resource.data) ||
              (request.resource.data.settings is map && isValidUserSettings()));
    }

    function isValidSharedPerson() {
      return hasOnlyAllowedFields(['id', 'name', 'phoneNumber', 'email', 'dateAdded', 'optInStatus']) &&
             hasRequiredFields(['id', 'name', 'dateAdded']) &&
             request.resource.data.id is string &&
             request.resource.data.id.size() <= 100 &&
             request.resource.data.name is string &&
             request.resource.data.name.size() <= 200 &&
             request.resource.data.dateAdded is number &&
             isValidOptionalString('phoneNumber', 30) &&
             isValidOptionalString('email', 200) &&
             isValidOptInStatus();
    }

    function isValidMissedPillAlert() {
      return hasOnlyAllowedFields(['caretakerPhone', 'medicationName', 'scheduledDate']) &&
             hasRequiredFields(['caretakerPhone', 'medicationName', 'scheduledDate']) &&
             request.resource.data.caretakerPhone is string &&
             request.resource.data.caretakerPhone.size() <= 30 &&
             request.resource.data.medicationName is string &&
             request.resource.data.medicationName.size() <= 200 &&
             request.resource.data.scheduledDate is number;
    }

    function isValidConnectionConfirmation() {
      return hasOnlyAllowedFields(['uid', 'sharedPersonId', 'phone', 'contactName', 'patientName']) &&
             hasRequiredFields(['uid', 'sharedPersonId', 'phone', 'contactName', 'patientName']) &&
             request.resource.data.uid is string &&
             request.resource.data.uid == request.auth.uid &&
             request.resource.data.sharedPersonId is string &&
             request.resource.data.sharedPersonId.size() <= 100 &&
             request.resource.data.phone is string &&
             request.resource.data.phone.size() <= 30 &&
             request.resource.data.contactName is string &&
             request.resource.data.contactName.size() <= 200 &&
             request.resource.data.patientName is string &&
             request.resource.data.patientName.size() <= 200;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile();

      match /doses/{medicationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDosesDoc();
      }

      match /sharedPeople/{personId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSharedPerson();
      }
    }

    match /missed_pill_alerts/{alertId} {
      allow create: if isSignedIn() && isValidMissedPillAlert();
      allow read, update, delete: if false;
    }

    match /connection_confirmations/{confirmationId} {
      allow create: if isSignedIn() && isValidConnectionConfirmation();
      allow read, update, delete: if false;
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
